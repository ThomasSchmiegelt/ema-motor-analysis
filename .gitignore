# ── ai-workspace Monorepo .gitignore ──────────────────────────────────────────
# Es wird NUR Quellcode versioniert. Laufzeitdaten, Build-Artefakte und native
# Binaries bleiben auf der Platte (der laufende Dienst nutzt sie), gehen aber NICHT
# in Git. Ein frischer Clone auf einem anderen Rechner müsste die nativen Teile
# (pikogk picogk.so / c-blosc) neu bauen — bewusst außerhalb dieses POC-Scopes.

# ── Python (cae_orchestrator, connection_detection) ──
__pycache__/
*.pyc
venv/
.venv/
*.egg-info/
.pytest_cache/

# ── cae_orchestrator: Laufzeit-/Zwischenartefakte (liegen ohnehin in ~/cae_projekte) ──
cae_orchestrator/**/__pycache__/

# ── physics_surrogate: Modelle + Trainingsdaten (GB-Größe, reproduzierbar) ──
# ACHTUNG: .gitignore kennt KEINE Kommentare am Zeilenende — ein "# …" hinter dem
# Muster wird Teil des Pfads und die Regel greift stillschweigend nicht mehr.
# (Genau so sind hier einmal 17 GB Datensatz durchgerutscht.)
# trainierte Gewichte (aus datasets/ reproduzierbar)
physics_surrogate/checkpoints/
# NPZ-Trainingsdaten (aus den Lösern regenerierbar, ~17 GB)
physics_surrogate/datasets/
# Auswertungs-/Laufausgaben je Training
physics_surrogate/outputs/

# ── .NET (pikogk) Build-Ausgaben ──
pikogk/**/bin/
pikogk/**/obj/
pikogk/**/.vs/

# ── pikogk: Laufzeitdaten + native Build-Artefakte (NICHT versionieren) ──
# 11 G generierte STL-Instanzen (Laufzeit-Store)
pikogk/PicoGKWebApi/data/
# Render-/Export-Ausgaben
pikogk/PicoGKWebApi/output/
# gebaute native Runtime (picogk.so + Abhängigkeiten)
pikogk/PicoGKRuntime/Dist/
# gebautes c-blosc-Install-Präfix.
# AUSNAHME: libblosc.{a,so.1.21.7} darunter sind ABSICHTLICH versioniert —
# sie werden mitverbreitet und tragen eine Lizenzpflicht (THIRD-PARTY-NOTICES.md:20).
# Bereits getrackte Dateien bleibt diese Regel wirkungslos gegenueber; sie greift nur
# fuer neu hinzukommende Build-Artefakte in diesem Praefix.
pikogk/local-install/
# vendored Third-Party-Build (rebuildbar)
pikogk/c-blosc/
# Prüfstands-/Testläufe
pikogk/logs/
# falls .NET SDK je hierher zeigt
pikogk/.dotnet/
# Installer-Skript (kein Source)
pikogk/dotnet-install.sh

# ── OS / Editor ──
.DS_Store
*.swp

# pikogk-Unterprojekte sind EIGENE Git-Repos (Leap71/Blosc + eigenes PicoGKWebApi) —
# nicht in den Monorepo einbetten; behalten ihre .git-Historie auf der Platte.
pikogk/PicoGK/
pikogk/PicoGKRuntime/
pikogk/PicoGKWebApi/
pikogk/PicoGK_Examples/
pikogk/c-blosc/

# lego: Laufzeitdaten (LDraw-Bibliothek, Kollisionsnetze, Wine-Prefix, Downloads)
lego/data/
lego/.venv/

# pikogk: Laufzeit-Logs
pikogk/logs/

# ── Sicherungsarchive (gehoeren nie ins Repo) ──
# Anlass: eine 283-MB-Sicherung lag ungeignort im Arbeitsbaum; GitHub lehnt Dateien
# ueber 100 MB ab, und ein Commit davor haette die Historie dauerhaft aufgeblaeht.
*_sicherung_*.zip
*.backup.zip
server.out
